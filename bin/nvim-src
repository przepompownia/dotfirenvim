#!/usr/bin/env bash

vimEnvDir="$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")"

mkdir -p /run/user/1000/firenvim
chmod 700 /run/user/1000/firenvim
cd /run/user/1000/firenvim || exit

unset NVIM_LISTEN_ADDRESS
if [ -n "$VIM" ] && [ ! -d "$VIM" ]; then
  unset VIM
fi
if [ -n "$VIMRUNTIME" ] && [ ! -d "$VIMRUNTIME" ]; then
  unset VIMRUNTIME
fi

. "${vimEnvDir}/lib/nvim-isolated"

runIsolated "$vimEnvDir" "${NVIM_FROM_SRC_DIR}/bin/nvim" \
    --headless \
    --cmd "so ${vimEnvDir}/nvim/preinit.vim" \
    -c "so ${vimEnvDir}/nvim/postinit.vim"
